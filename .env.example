PORT=3000
MAX_FILE_MB=25
MAX_FILES=10
MAX_PAGES=100
RATE_LIMIT_MAX=100
# auto = LibreOffice if installed, otherwise plain-text fallback. Or: libreoffice | text
PDF_TO_WORD_ENGINE=auto
# Only needed if soffice is not on PATH
LIBREOFFICE_PATH=
TEMP_DIR=
# Set true when running behind nginx/Caddy
TRUST_PROXY=false
